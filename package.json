{
  "name": "friday",
  "version": "0.0.0-nightly.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @friday/friday build",
    "check": "pnpm --recursive --if-present check",
    "dev": "pnpm --filter @friday/friday dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "effect-tsgo patch --no-typescript --oxlint && oxlint .",
    "mutation:system-prompt": "stryker run stryker.config.json --inPlace",
    "mutation:tasks": "stryker run stryker.tasks.config.json --inPlace",
    "mutation:access": "stryker run stryker.access.config.json --inPlace",
    "mutation:discord-config": "stryker run stryker.discord-config.config.json --inPlace",
    "release:build": "bun scripts/build-release.ts",
    "release:version": "bun scripts/release-version.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts' --exclude '**/*.live.test.ts' && pnpm --filter @friday/friday test:integration",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.77.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "effect": "catalog:",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.11.0"
}
