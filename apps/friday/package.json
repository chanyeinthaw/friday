{
  "name": "@friday/friday",
  "version": "0.0.0-nightly.22",
  "private": true,
  "bin": {
    "friday": "dist/friday"
  },
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --compile --outfile ./dist/friday",
    "check": "effect-tsgo patch --typescript && tsc --noEmit",
    "dev": "NODE_ENV=development bun run ./src/main.ts",
    "test": "vitest run",
    "test:integration": "bun test $(find ./src -name '*.integration.test.ts' -print)",
    "test:live:pi": "bun test ./src/harness/pi/PiThreadRuntime.live.test.ts"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.38.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@effect/platform-bun": "4.0.0-rc.109",
    "@effect/sql-sqlite-bun": "4.0.0-rc.109",
    "@friday/contracts": "workspace:*",
    "chat": "4.38.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/sql-sqlite-node": "4.0.0-rc.109",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "1.3.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
