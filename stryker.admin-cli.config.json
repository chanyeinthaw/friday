{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "apps/friday/src/Cli.ts",
    "apps/friday/src/config/DiscordAdmins.ts",
    "apps/friday/src/config/AppConfigLive.ts"
  ],
  "testFiles": [
    "apps/friday/src/Cli.test.ts",
    "apps/friday/src/config/DiscordAdmins.test.ts",
    "apps/friday/src/config/AppConfigLive.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": null
  },
  "concurrency": 2
}
