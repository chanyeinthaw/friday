{
  "name": "orbs-at-home",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @orbs-at-home/friday build",
    "check": "pnpm --recursive --if-present check",
    "dev": "pnpm --filter @orbs-at-home/friday dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "effect-tsgo patch --no-typescript --oxlint && oxlint .",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.77.0",
    "effect": "catalog:",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.11.0"
}
